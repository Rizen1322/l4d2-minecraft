// Generated by tools/build_hud.py from hud_layout.py. Native panel footprints only.
uniform int TeammateHudCount = 0;
bool nativeTeamHud(float2 pixel)
{
    const float2 p = pixel * (480.0 / BUFFER_HEIGHT);
    if (p.x < 3.0 || p.x >= 117.0) return false;
    [unroll] for (int slot = 0; slot < 3; ++slot)
    {
        const float top = 424.0 - slot * 49.0;
        if (slot < TeammateHudCount && p.y >= top && p.y < top + 60.0) return true;
    }
    return false;
}
