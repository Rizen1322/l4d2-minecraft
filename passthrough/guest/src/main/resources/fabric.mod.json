{
	"schemaVersion": 1,
	"id": "passthrough",
	"version": "${version}",
	"name": "L4D2 Minecraft Guest",
	"description": "Runs alongside another game: its camera drives Minecraft's, its collision becomes invisible blocks, and Minecraft's picture (colour + depth) is handed back to be composited into the host game.",
	"authors": [
		"rehan (base passthrough)", "L4D2MC adaptation"
	],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.rehan.passthrough.Passthrough"
		],
		"client": [
			"dev.rehan.passthrough.client.PassthroughClient"
		]
	},
	"mixins": [
		"passthrough.mixins.json",
		{
			"config": "passthrough.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
