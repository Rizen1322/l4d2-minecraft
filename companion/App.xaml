<Application x:Class="L4D2MC.Companion.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#B7ED57" />
    <SolidColorBrush x:Key="Muted" Color="#98A2B3" />
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F0F3F8"/><Setter Property="Background" Value="#28303D"/><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#142109"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0F141D"/><Setter Property="Foreground" Value="#E2E8F0"/><Setter Property="BorderBrush" Value="#343E4C"/><Setter Property="Padding" Value="11,9"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,7,0,14"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,7,0,14"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D6DDE7"/><Setter Property="Margin" Value="0,10,0,12"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1A212C"/><Setter Property="BorderBrush" Value="#2B3543"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Padding" Value="23"/><Setter Property="Margin" Value="0,0,0,17"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
  </Application.Resources>
</Application>
