<Window x:Class="L4D2MC.Companion.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="L4D2 × Minecraft" Width="1120" Height="790" MinWidth="950" MinHeight="650" Background="#10151E" Foreground="#F0F3F8" WindowStartupLocation="CenterScreen">
 <Grid Background="#10151E" TextOptions.TextRenderingMode="Grayscale"><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#151C26" Padding="24,32"><DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="L4D2 × MC" FontSize="26" FontWeight="Black" Foreground="{StaticResource Accent}"/><TextBlock Text="COMPANION / 0.3" Style="{StaticResource Label}" Margin="0,7,0,32"/>
    <Button Content="◈   Обзор" Tag="Home" Click="Navigate" Margin="0,0,0,10"/><Button Content="↓   Установка" Tag="Install" Click="Navigate" Margin="0,0,0,10"/><Button Content="◎   Кооператив" Tag="Coop" Click="Navigate" Margin="0,0,0,10"/><Button Content="▶   Играть" Tag="Play" Click="Navigate" Margin="0,0,0,10"/><Button Content="≡   Журнал" Tag="Logs" Click="Navigate"/>
   </StackPanel><StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="Две игры. Одна карта." FontSize="13"/><TextBlock Text="Windows • Steam • Java Edition" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,8,0,18"/><Button Content="GitHub ↗" Click="GitHub"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="32,28"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <StackPanel x:Name="Home"><TextBlock Text="Твой Minecraft. В L4D2." FontSize="31" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="Установка, обновления и кооп в одном окне." Foreground="{StaticResource Muted}" Margin="0,0,0,25"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Готовность системы" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="Health" FontSize="14" LineHeight="28" Margin="0,16,0,15"/><Button Content="Проверить ещё раз" Click="Refresh" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Начни с установки" FontSize="20" FontWeight="Bold"/><TextBlock Text="Выбери папки игр. Приложение скачает исходники с GitHub, подготовит инструменты и установит мод. Затем запусти профиль Minecraft в своём лаунчере и нажми «Запустить связку»." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,20"/><Button Style="{StaticResource Primary}" Content="Настроить →" Tag="Install" Click="Navigate" HorizontalAlignment="Left"/></StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="Install" Visibility="Collapsed"><TextBlock Text="Установка и обновления" FontSize="29" FontWeight="Bold" Margin="0,0,0,20"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Папки" FontSize="18" FontWeight="Bold"/><TextBlock Text="Проект мода · отдельная папка" Style="{StaticResource Label}" Margin="0,14,0,0"/><DockPanel><Button Content="…" Tag="Project" Click="Browse" DockPanel.Dock="Right"/><TextBox x:Name="ProjectPath"/></DockPanel><TextBlock Text="Left 4 Dead 2 · папка с left4dead2.exe" Style="{StaticResource Label}"/><DockPanel><Button Content="…" Tag="Game" Click="Browse" DockPanel.Dock="Right"/><TextBox x:Name="GamePath"/></DockPanel><TextBlock Text="Minecraft · папка с versions" Style="{StaticResource Label}"/><DockPanel><Button Content="…" Tag="Minecraft" Click="Browse" DockPanel.Dock="Right"/><TextBox x:Name="MinecraftPath"/></DockPanel><Button Content="Найти автоматически" Click="Detect" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Скачать → собрать → установить" FontSize="18" FontWeight="Bold"/><TextBlock Text="Нужны купленные игры и официальные L4D2 Authoring Tools. Перед установкой закрой обе игры. Инструменты скачиваются в папку проекта; аудио и текстуры берутся из твоих игр." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,20"/><WrapPanel><Button Content="Скачать / обновить проект" Click="Download"/><Button Content="Установить мод" Style="{StaticResource Primary}" Click="InstallMod"/><Button Content="Authoring Tools ↗" Click="Authoring" Margin="0,12,0,0"/></WrapPanel></StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="Coop" Visibility="Collapsed"><TextBlock Text="Идём вдвоём" FontSize="29" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock x:Name="RoomState" Foreground="{StaticResource Accent}" Margin="0,0,0,20"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Создать комнату" FontSize="19" FontWeight="Bold"/><TextBlock Text="Выбери адрес общей LAN/VPN сети. Приглашение содержит ключ комнаты — отправь его только другу." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,8"/><ComboBox x:Name="Address" IsEditable="True"/><Button Content="Создать и скопировать приглашение" Style="{StaticResource Primary}" Click="HostRoom" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Присоединиться к другу" FontSize="19" FontWeight="Bold"/><TextBlock Text="Приглашение" Style="{StaticResource Label}" Margin="0,12,0,7"/><PasswordBox x:Name="Invite" Padding="10" Background="#10151E" Foreground="White" BorderBrush="#343E4C"/><TextBlock Text="Твой собственный ник в L4D2 · не ник хоста" Style="{StaticResource Label}" Margin="0,15,0,0"/><TextBox x:Name="Player"/><Button Content="Сохранить подключение" Click="JoinRoom" HorizontalAlignment="Left"/></StackPanel></Border><Button Content="Вернуться в одиночный режим" Click="Solo" HorizontalAlignment="Left"/>
    </StackPanel>
    <StackPanel x:Name="Play" Visibility="Collapsed"><TextBlock Text="Поехали" FontSize="29" FontWeight="Bold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="1 / Запусти Minecraft" FontSize="19" FontWeight="Bold"/><TextBlock Text="В своём лаунчере выбери L4D2MC-Fabric-26.3. Используй обычный вход в аккаунт. Приложение не запрашивает пароль Minecraft." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,18"/><Button Content="Открыть Minecraft / лаунчер" Click="OpenMinecraft" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="2 / Запусти связку" FontSize="19" FontWeight="Bold"/><TextBlock Text="Мост и L4D2 запустятся вместе. В коопе автоматически используется сохранённая комната. Оставь это окно открытым во время игры." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,15"/><WrapPanel><StackPanel Width="140"><TextBlock Text="Ширина" Style="{StaticResource Label}"/><TextBox x:Name="ViewWidth"/></StackPanel><StackPanel Width="140" Margin="15,0,0,0"><TextBlock Text="Высота" Style="{StaticResource Label}"/><TextBox x:Name="ViewHeight"/></StackPanel></WrapPanel><Button Content="▶  Запустить связку" Click="Launch" Style="{StaticResource Primary}" HorizontalAlignment="Left"/></StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="Logs" Visibility="Collapsed"><TextBlock Text="Журнал" FontSize="29" FontWeight="Bold" Margin="0,0,0,20"/><TextBox x:Name="LogText" Height="470" IsReadOnly="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><Button Content="Открыть файл журнала" Click="OpenLog" HorizontalAlignment="Left"/></StackPanel>
   </StackPanel></ScrollViewer>
   <StackPanel Grid.Row="1" Margin="0,20,0,0"><ProgressBar x:Name="Progress" Height="4" Foreground="{StaticResource Accent}" Background="#28303D" BorderThickness="0"/><TextBlock x:Name="Status" Text="Готово" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
  </Grid>
 </Grid>
</Window>
